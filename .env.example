# Local settings, read by compose.yml and examples/curl-example.sh.
# Copy to .env (git-ignored) and change what you need; without a .env the defaults apply.

# Host port the container is published on (127.0.0.1 only). Default 8080.
PIXELBRIDGE_PORT=8080

# Swagger UI at /docs: "embed" (compiled into the binary, default) or "cdn".
# SWAGGER_UI=embed

# Log level: error, warn, info (default), debug, trace.
# RUST_LOG=info
